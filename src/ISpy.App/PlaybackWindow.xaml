<Window x:Class="ISpy.App.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ISpy.App"
        Title="Playback - ISpy" Height="760" Width="1220"
        Icon="Assets/ISpy.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,9">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/ISpy-header.png" Width="18" Height="18" Margin="0,0,8,0"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Playback" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Save clip…" Padding="12,4"
                Margin="8,0,0,0" Click="OnExport" IsEnabled="False" />
        <Button x:Name="LoadButton" DockPanel.Dock="Right" Content="Load day" Padding="12,4"
                Click="OnLoadDay" />
        <DatePicker x:Name="DayPicker" DockPanel.Dock="Right" Width="130" Margin="0,0,8,0" />
        <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMuted}" Text="Pick a camera." />
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="14,12,14,6" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}" Text="CAMERAS" />
        <ListBox x:Name="CameraList" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource Text}" DisplayMemberPath="Label"
                 SelectionChanged="OnCameraSelected" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Background="#0B0D12">
      <local:VideoCanvas x:Name="VideoHost" />
      <TextBlock x:Name="CanvasHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" Foreground="{StaticResource TextMuted}"
                 Text="Choose a camera, then a day." />
    </Grid>

    <local:TimelineBar x:Name="Timeline" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,1,0,0" />

    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,8">
      <DockPanel>
        <Button x:Name="PlayButton" Content="Pause" Padding="14,4" Click="OnTogglePlay" IsEnabled="False" />
        <Button Content="−30s" Padding="10,4" Margin="8,0,0,0" Tag="-30" Click="OnNudge" />
        <Button Content="−10s" Padding="10,4" Margin="4,0,0,0" Tag="-10" Click="OnNudge" />
        <Button Content="+10s" Padding="10,4" Margin="4,0,0,0" Tag="10" Click="OnNudge" />
        <Button Content="+30s" Padding="10,4" Margin="4,0,0,0" Tag="30" Click="OnNudge" />

        <TextBlock Text="Speed" Margin="16,0,6,0" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMuted}" />
        <Button Content="1×" Padding="10,4" Tag="1" Click="OnSetSpeed" />
        <Button Content="4×" Padding="10,4" Margin="4,0,0,0" Tag="4" Click="OnSetSpeed" />
        <Button Content="16×" Padding="10,4" Margin="4,0,0,0" Tag="16" Click="OnSetSpeed" />

        <TextBlock x:Name="PositionText" DockPanel.Dock="Right" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMuted}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
