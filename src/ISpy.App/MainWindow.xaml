<Window x:Class="ISpy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ISpy.App"
        Title="ISpy" Height="720" Width="1180"
        Icon="Assets/ISpy.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/ISpy-header.png" Width="20" Height="20" Margin="0,0,8,0"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="ISpy" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="UpdateIndicator" DockPanel.Dock="Right" Visibility="Collapsed"
                   VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="{StaticResource Accent}" Cursor="Hand" Text="Update available"
                   MouseLeftButtonUp="OnUpdateClicked" />
        <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add recorder" Padding="12,4"
                Margin="8,0,0,0" Click="OnAddDevice" />
        <ComboBox x:Name="LayoutPicker" DockPanel.Dock="Right" MinWidth="110" Margin="8,0,8,0"
                  VerticalAlignment="Center" SelectionChanged="OnLayoutPicked" />
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="12,4"
                Click="OnRefresh" />
        <Button x:Name="PlaybackButton" DockPanel.Dock="Right" Content="Playback" Padding="12,4"
                Margin="0,0,8,0" Click="OnOpenPlayback" />
        <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMuted}" Text="Starting…" />
      </DockPanel>
    </Border>

    <!-- Device / camera list -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="16,14,16,8" Foreground="{StaticResource TextMuted}"
                   FontSize="11" FontWeight="SemiBold" Text="CAMERAS" />
        <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Margin="16,4,16,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMuted}" Visibility="Collapsed"
                   Text="No recorder saved yet. Choose Add recorder to search your network." />
        <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource Text}" />
      </DockPanel>
    </Border>

    <!-- Video canvas. The child HWND the swapchain presents into; nothing may be layered over it,
         so tile labels are drawn inside the swapchain with Direct2D. -->
    <Grid Grid.Row="1" Grid.Column="1" Background="#0B0D12">
      <local:VideoCanvas x:Name="VideoHost" />
      <TextBlock x:Name="CanvasHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"
                 Text="Add a recorder to see your cameras." />
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <TextBlock x:Name="VersionText" DockPanel.Dock="Right"
                   Foreground="{StaticResource TextMuted}" FontSize="11" />
        <TextBlock x:Name="StartupText" Foreground="{StaticResource TextMuted}" FontSize="11" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
