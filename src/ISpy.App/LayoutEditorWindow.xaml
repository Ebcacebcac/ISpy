<Window x:Class="ISpy.App.LayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Design a layout - ISpy" Height="560" Width="640"
        Icon="Assets/ISpy.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="RowsBox" DockPanel.Dock="Right" Width="52" SelectionChanged="OnGridSizeChanged" />
      <TextBlock DockPanel.Dock="Right" Text="rows" VerticalAlignment="Center" Margin="8,0,6,0"
                 Foreground="{StaticResource TextMuted}" />
      <ComboBox x:Name="ColumnsBox" DockPanel.Dock="Right" Width="52" SelectionChanged="OnGridSizeChanged" />
      <TextBlock DockPanel.Dock="Right" Text="columns" VerticalAlignment="Center" Margin="16,0,6,0"
                 Foreground="{StaticResource TextMuted}" />
      <TextBox x:Name="NameBox" Padding="4,3" />
    </DockPanel>

    <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
               Margin="0,0,0,10"
               Text="Drag across cells to merge them into one large tile. Click a large tile to split it again. The numbers show which camera lands in each tile — cameras fill tiles top-to-bottom, left-to-right, and you can drag them between tiles on the live grid afterwards." />

    <Border Grid.Row="2" Background="#0B0D12" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="4" Padding="6">
      <Grid x:Name="Board"
            MouseLeftButtonDown="OnBoardMouseDown"
            MouseMove="OnBoardMouseMove"
            MouseLeftButtonUp="OnBoardMouseUp"
            Background="Transparent" />
    </Border>

    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save layout" Padding="18,6"
              IsDefault="True" Click="OnSave" />
      <Button DockPanel.Dock="Right" Content="Cancel" Padding="18,6" Margin="0,0,8,0" IsCancel="True" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                 Foreground="{StaticResource TextMuted}" />
    </DockPanel>
  </Grid>
</Window>
