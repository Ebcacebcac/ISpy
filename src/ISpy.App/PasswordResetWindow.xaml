<Window x:Class="ISpy.App.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover access - ISpy" Height="620" Width="640"
        Icon="Assets/ISpy.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
      <Image Source="Assets/ISpy-header.png" Width="22" Height="22" Margin="0,0,10,0"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <TextBlock Text="Recover access to this device" FontSize="16" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </StackPanel>

    <!-- The device we are recovering -->
    <Border Grid.Row="1" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock x:Name="DeviceName" FontWeight="SemiBold" FontSize="13" />
        <TextBlock x:Name="DeviceDetail" Foreground="{StaticResource TextMuted}" FontSize="11"
                   Margin="0,3,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Steps -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12">
          Your device password lives on the device itself and can't be read back — but you can
          reset it, because you own it. ISpy can't perform the reset itself (that's the security
          check), so it gathers what the reset needs and hands you to the fastest route.
        </TextBlock>

        <TextBlock Text="Step 1 — Reset through your Guarding Vision account (fastest)"
                   FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6">
          In the Guarding Vision app (signed in to your account), open this device, then its
          Settings — look for Change Password or Reset Device Password. Because you're the verified
          owner, it lets you set a new admin password. On older firmware this option may be absent;
          if so, use Step 2.
        </TextBlock>

        <TextBlock Text="Step 2 — Or send the details to your reseller"
                   FontWeight="SemiBold" Margin="0,8,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6">
          The reseller (or Hikvision support) computes an unlock code from the device serial and
          its current date. Export the details below and send them; they'll reply with a code and
          instructions.
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Button x:Name="CopyButton" Content="Copy details" Padding="12,5" Click="OnCopy" />
          <Button x:Name="SaveButton" Content="Save to file…" Padding="12,5" Margin="8,0,0,0"
                  Click="OnSave" />
          <TextBlock x:Name="ExportStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                     Foreground="{StaticResource Accent}" />
        </StackPanel>

        <TextBlock Text="Step 3 — Come back and connect" FontWeight="SemiBold" Margin="0,8,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}">
          Once you've set a new admin password by either route, type it below and ISpy will connect
          straight away — no need to reopen the Add recorder dialog.
        </TextBlock>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" VerticalAlignment="Center"
                     Margin="0,0,10,6" />
          <TextBox x:Name="UserBox" Grid.Row="0" Grid.Column="1" Text="admin" Padding="4,3"
                   Margin="0,0,0,6" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="New password" VerticalAlignment="Center"
                     Margin="0,0,10,0" />
          <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Padding="4,3" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Connect" Padding="18,6"
              IsDefault="True" Click="OnConnect" />
      <Button DockPanel.Dock="Right" Content="Close" Padding="18,6" Margin="0,0,8,0" IsCancel="True" />
      <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap"
                 Foreground="{StaticResource TextMuted}" />
    </DockPanel>
  </Grid>
</Window>
