<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ISpy.App</RootNamespace>
    <AssemblyName>ISpy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ISpy.ico</ApplicationIcon>
    <!-- Startup budget: no satellite assembly probing, no unnecessary JIT on the paint path. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <!-- Never set InvariantGlobalization here: WPF resolves the active keyboard layout's culture
         (e.g. 0x0809, English UK) whenever a text box gets focus, and in invariant mode that
         construction throws on the UI thread. It presented as "the app closes when I click into
         the Add recorder dialog" - the few milliseconds ICU costs at startup are not worth it. -->
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ISpy.ico" />
    <Resource Include="Assets/ISpy-header.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ISpy.Core/ISpy.Core.csproj" />
    <ProjectReference Include="..\ISpy.Media\ISpy.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
